{
  "version": 1,
  "id": "editorSettings",
  "states": {
    "apiKey": {
      "type": "string",
      "initial": ""
    },
    "soundsDirectory": {
      "type": "string",
      "initial": ""
    },
    "imagesDirectory": {
      "type": "string",
      "initial": ""
    },
    "basePrompt": {
      "type": "string",
      "initial": ""
    },
    "defaultVisualEffect": {
      "type": "string",
      "initial": "none"
    },
    "visualEffectOptions": {
      "type": "string",
      "initial": "[]"
    },
    "visualEffectStrength": {
      "type": "string",
      "initial": "1.0"
    },
    "mensagem": {
      "type": "string",
      "initial": ""
    },
    "showGeneral": {
      "type": "boolean",
      "initial": true
    },
    "showVisual": {
      "type": "boolean",
      "initial": false
    },
    "showAvatar": {
      "type": "boolean",
      "initial": false
    },
    "showPrompt": {
      "type": "boolean",
      "initial": false
    },
    "showImages": {
      "type": "boolean",
      "initial": false
    },
    "projectImagePrompt": {
      "type": "string",
      "initial": ""
    },
    "defaultImagePrompt": {
      "type": "string",
      "initial": ""
    },
    "sceneCaptions": {
      "type": "string",
      "initial": "off"
    },
    "sceneCaptionOptions": {
      "type": "string",
      "initial": "[]"
    },
    "soundEffectPercent": {
      "type": "string",
      "initial": "100"
    },
    "soundEffectPercentOptions": {
      "type": "string",
      "initial": "[]"
    },
    "avatarDirectory": {
      "type": "string",
      "initial": ""
    },
    "ffmpegExecutable": {
      "type": "string",
      "initial": ""
    },
    "ffprobeExecutable": {
      "type": "string",
      "initial": ""
    },
    "showTools": {
      "type": "boolean",
      "initial": false
    },
    "narrationLanguage": {
      "type": "string",
      "initial": "pt"
    },
    "narrationLanguageOptions": {
      "type": "string",
      "initial": "[]"
    }
  },
  "view": {
    "type": "Column",
    "props": {
      "padding": 20,
      "spacing": 12,
      "fillWidth": true,
      "fillHeight": true
    },
    "children": [
      {
        "type": "Text",
        "style": {
          "fontSize": 24
        },
        "props": {
          "text": "Configurações"
        }
      },
      {
        "type": "Row",
        "id": "settingsBody",
        "props": {
          "spacing": 18,
          "fillWidth": true,
          "fillHeight": true
        },
        "children": [
          {
            "type": "Column",
            "id": "settingsSidebar",
            "props": {
              "spacing": 9
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": "SEÇÕES"
                }
              },
              {
                "type": "Button",
                "id": "settingsNavGeneral",
                "props": {
                  "text": "Geral",
                  "height": 40
                },
                "events": {
                  "onClick": "showGeneral"
                }
              },
              {
                "type": "Button",
                "id": "settingsNavVisual",
                "props": {
                  "text": "Efeitos visuais",
                  "height": 40
                },
                "events": {
                  "onClick": "showVisual"
                }
              },
              {
                "type": "Button",
                "id": "settingsNavTools",
                "props": {
                  "text": "Ferramentas",
                  "height": 40
                },
                "events": {
                  "onClick": "showTools"
                }
              },
              {
                "type": "Button",
                "id": "settingsNavAvatar",
                "props": {
                  "text": "Avatar",
                  "height": 40
                },
                "events": {
                  "onClick": "showAvatar"
                }
              },
              {
                "type": "Button",
                "id": "settingsNavPrompt",
                "props": {
                  "text": "Prompt base",
                  "height": 40
                },
                "events": {
                  "onClick": "showPrompt"
                }
              },
              {
                "type": "Button",
                "id": "settingsNavImages",
                "props": {
                  "text": "Imagens do projeto",
                  "height": 40
                },
                "events": {
                  "onClick": "showImages"
                }
              }
            ]
          },
          {
            "type": "Scroll",
            "id": "settingsScroll",
            "props": {
              "fillWidth": true,
              "fillHeight": true
            },
            "children": [
              {
                "type": "Column",
                "id": "settingsContent",
                "props": {
                  "padding": 16,
                  "spacing": 14,
                  "fillWidth": true
                },
                "children": [
                  {
                    "type": "Column",
                    "id": "settingsGeneralPanel",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "bind": {
                      "visible": "showGeneral"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 20
                        },
                        "props": {
                          "text": "Geral"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Acesso à IA e biblioteca local de sons.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "OpenAI API key"
                        }
                      },
                      {
                        "type": "PasswordInput",
                        "id": "settingsApiKey",
                        "props": {
                          "placeholder": "Sua chave da OpenAI",
                          "height": 36,
                          "width": 530
                        },
                        "bind": {
                          "value": "apiKey"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "A chave é salva somente nas configurações locais deste aplicativo.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Biblioteca global de imagens"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "imagesDirectoryInput",
                        "props": {
                          "height": 36,
                          "width": 530,
                          "placeholder": "Pasta compartilhada de imagens geradas"
                        },
                        "bind": {
                          "value": "imagesDirectory"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "chooseImagesButton",
                        "props": {
                          "text": "Selecionar pasta de imagens…",
                          "height": 36
                        },
                        "events": {
                          "onClick": "chooseImages"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Imagens geradas ficam nesta biblioteca e podem ser reutilizadas em outros projetos.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Biblioteca de sons"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "soundsDirectoryInput",
                        "props": {
                          "height": 36,
                          "width": 530,
                          "placeholder": "Diretório de sons e efeitos"
                        },
                        "bind": {
                          "value": "soundsDirectory"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "chooseSoundsButton",
                        "props": {
                          "text": "Selecionar pasta…",
                          "height": 36
                        },
                        "events": {
                          "onClick": "chooseSounds"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "O agente poderá usar os arquivos desta pasta e de suas subpastas na montagem do vídeo.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Cobertura de efeitos sonoros"
                        }
                      },
                      {
                        "type": "Select",
                        "id": "soundEffectPercentInput",
                        "props": {
                          "height": 36
                        },
                        "bind": {
                          "value": "soundEffectPercent",
                          "items": "soundEffectPercentOptions"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Percentual máximo de cenas que receberão efeitos ao clicar em Aplicar sons. A música de fundo é independente.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Idioma da narração no CLI"
                        }
                      },
                      {
                        "type": "Select",
                        "id": "narrationLanguageInput",
                        "props": {
                          "width": 260,
                          "height": 36
                        },
                        "bind": {
                          "value": "narrationLanguage",
                          "items": "narrationLanguageOptions"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Use o roteiro no idioma escolhido. No Ressoa, o sotaque depende da voz e do motor.",
                          "wrapWidth": 520
                        }
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "id": "settingsVisualPanel",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "bind": {
                      "visible": "showVisual"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 20
                        },
                        "props": {
                          "text": "Efeitos visuais"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Padrões para novas cenas e intensidade do projeto.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Efeito visual padrão para cenas novas"
                        }
                      },
                      {
                        "type": "Select",
                        "id": "defaultVisualEffectInput",
                        "props": {
                          "width": 240,
                          "height": 36
                        },
                        "bind": {
                          "value": "defaultVisualEffect",
                          "items": "visualEffectOptions"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Intensidade dos efeitos visuais (0,25 a 3)"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "visualEffectStrengthInput",
                        "props": {
                          "width": 150,
                          "height": 36,
                          "placeholder": "Ex.: 1,5"
                        },
                        "bind": {
                          "value": "visualEffectStrength"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "1 mantém o movimento atual. Este valor é salvo no projeto para que a exportação reproduza a prévia.",
                          "wrapWidth": 520
                        }
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "id": "settingsToolsPanel",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "bind": {
                      "visible": "showTools"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 20
                        },
                        "props": {
                          "text": "Ferramentas locais"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Deixe um campo vazio para detectar automaticamente. Caminhos específicos permitem usar outras instalações no seu computador.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "FFmpeg para exportação e efeitos"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "ffmpegExecutableInput",
                        "props": {
                          "height": 36,
                          "width": 530,
                          "placeholder": "Ex.: /usr/bin/ffmpeg"
                        },
                        "bind": {
                          "value": "ffmpegExecutable"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "FFprobe para medir narração"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "ffprobeExecutableInput",
                        "props": {
                          "height": 36,
                          "width": 530,
                          "placeholder": "Ex.: /usr/bin/ffprobe"
                        },
                        "bind": {
                          "value": "ffprobeExecutable"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "id": "settingsAvatarPanel",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "bind": {
                      "visible": "showAvatar"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 20
                        },
                        "props": {
                          "text": "Avatar"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Pasta de avatares deste projeto. Pode conter variações e subpastas.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Input",
                        "id": "avatarDirectoryInput",
                        "props": {
                          "height": 36,
                          "width": 530,
                          "placeholder": "/home/eliezer/Desktop/backup/imagens_para_uso/avatar-hibrido-triceratops"
                        },
                        "bind": {
                          "value": "avatarDirectory"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "chooseAvatarButton",
                        "props": {
                          "text": "Selecionar pasta…",
                          "height": 36
                        },
                        "events": {
                          "onClick": "chooseAvatar"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "O caminho é salvo no arquivo do projeto; as imagens continuam na pasta original. Deixe vazio se este projeto não usar avatar.",
                          "wrapWidth": 520
                        }
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "id": "settingsPromptPanel",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "bind": {
                      "visible": "showPrompt"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 20
                        },
                        "props": {
                          "text": "Prompt base"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Instruções usadas na geração do vídeo.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Prompt base da geração de vídeo"
                        }
                      },
                      {
                        "type": "TextArea",
                        "id": "basePromptInput",
                        "props": {
                          "height": 260,
                          "width": 530,
                          "placeholder": "Instruções para o agente de IA"
                        },
                        "bind": {
                          "value": "basePrompt"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "resetPromptButton",
                        "props": {
                          "text": "Restaurar prompt padrão",
                          "height": 36
                        },
                        "events": {
                          "onClick": "resetPrompt"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "id": "settingsImagesPanel",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "bind": {
                      "visible": "showImages"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 20
                        },
                        "props": {
                          "text": "Imagens do projeto"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Texto breve sobre a imagem"
                        }
                      },
                      {
                        "type": "Select",
                        "id": "sceneCaptionsInput",
                        "props": {
                          "height": 36
                        },
                        "bind": {
                          "value": "sceneCaptions",
                          "items": "sceneCaptionOptions"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Mostra um texto curto no canto inferior esquerdo de cada cena, na prévia e no MP4, sem alterar nem regerar as imagens. Edite o texto de cada cena no painel da cena; vazio usa uma sugestão tirada da fala.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Prompt de geração de imagens válido somente para o projeto aberto. Ele substitui as instruções padrão abaixo; o contexto do roteiro e o texto de cada cena continuam sendo acrescentados automaticamente. Deixe vazio para usar o padrão.",
                          "wrapWidth": 520
                        }
                      },
                      {
                        "type": "TextArea",
                        "id": "projectImagePromptInput",
                        "props": {
                          "height": 260,
                          "width": 530,
                          "placeholder": "Estilo, paleta, elementos permitidos e proibidos para as imagens deste projeto"
                        },
                        "bind": {
                          "value": "projectImagePrompt"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "clearImagePromptButton",
                        "props": {
                          "text": "Usar prompt padrão",
                          "height": 36
                        },
                        "events": {
                          "onClick": "clearImagePrompt"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Prompt padrão do editor:"
                        }
                      },
                      {
                        "type": "Text",
                        "id": "defaultImagePromptText",
                        "props": {
                          "wrapWidth": 520
                        },
                        "bind": {
                          "text": "defaultImagePrompt"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "O prompt é salvo no arquivo do projeto. Imagens já anexadas não são refeitas; um prompt diferente não reaproveita imagens da biblioteca geradas com outras instruções.",
                          "wrapWidth": 520
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Text",
        "id": "settingsMessage",
        "props": {
          "wrapWidth": 850
        },
        "bind": {
          "text": "mensagem"
        }
      },
      {
        "type": "Row",
        "props": {
          "spacing": 12
        },
        "children": [
          {
            "type": "Button",
            "id": "saveSettingsButton",
            "props": {
              "text": "Salvar configurações",
              "height": 36
            },
            "events": {
              "onClick": "saveSettings"
            }
          },
          {
            "type": "Button",
            "id": "cancelSettingsButton",
            "props": {
              "text": "Cancelar",
              "height": 36
            },
            "events": {
              "onClick": "cancelSettings"
            }
          }
        ]
      }
    ]
  }
}
