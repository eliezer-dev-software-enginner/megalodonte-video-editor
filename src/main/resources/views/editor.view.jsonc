{
  "$schema": "../../../../../megalodonte-jsonc-ui/schema/view.schema.json",
  "version": 1,
  "id": "editor",
  "states": {
    "roteiro": {
      "type": "string",
      "initial": ""
    },
    "timeline": {
      "type": "string",
      "initial": "[]"
    },
    "resumo": {
      "type": "string",
      "initial": "0 cenas · 0 segundos"
    },
    "imagem": {
      "type": "string",
      "initial": ""
    },
    "motionEffect": {
      "type": "string",
      "initial": "none"
    },
    "motionEffectBusy": {
      "type": "boolean",
      "initial": false
    },
    "motionEffectOptions": {
      "type": "string",
      "initial": "[]"
    },
    "cenaTexto": {
      "type": "string",
      "initial": "Nenhuma cena selecionada"
    },
    "duracao": {
      "type": "string",
      "initial": "5"
    },
    "mensagem": {
      "type": "string",
      "initial": "Cole o roteiro à direita. Separe as cenas com uma linha em branco."
    },
    "selecionada": {
      "type": "integer",
      "initial": -1
    },
    "semSelecao": {
      "type": "boolean",
      "initial": true
    },
    "playLabel": {
      "type": "string",
      "initial": "▶ Play"
    },
    "tempo": {
      "type": "string",
      "initial": "0.0s / 0.0s"
    },
    "semCenas": {
      "type": "boolean",
      "initial": true
    },
    "narracaoNome": {
      "type": "string",
      "initial": "Nenhuma narração anexada"
    },
    "whisperStatus": {
      "type": "string",
      "initial": ""
    },
    "whisperDisabled": {
      "type": "boolean",
      "initial": true
    },
    "soundStatus": {
      "type": "string",
      "initial": ""
    },
    "musicaNome": {
      "type": "string",
      "initial": "Nenhuma música anexada"
    },
    "volumeNarracao": {
      "type": "string",
      "initial": "100"
    },
    "volumeMusica": {
      "type": "string",
      "initial": "15"
    },
    "exportStatus": {
      "type": "string",
      "initial": ""
    },
    "exportando": {
      "type": "boolean",
      "initial": false
    },
    "semNarracao": {
      "type": "boolean",
      "initial": true
    },
    "semMusica": {
      "type": "boolean",
      "initial": true
    },
    "gerandoImagens": {
      "type": "boolean",
      "initial": false
    },
    "iaStatus": {
      "type": "string",
      "initial": "OpenAI · gera e anexa as imagens pendentes em sequência"
    },
    "openaiKey": {
      "type": "string",
      "initial": ""
    },
    "themeAction": {
      "type": "string",
      "initial": "☾ Tema lua"
    },
    "efeitosTimeline": {
      "type": "string",
      "initial": "[]"
    },
    "efeitoSelecionado": {
      "type": "integer",
      "initial": -1
    },
    "semEfeito": {
      "type": "boolean",
      "initial": true
    },
    "efeitoNome": {
      "type": "string",
      "initial": "Selecione um som"
    },
    "efeitoInicio": {
      "type": "string",
      "initial": "0"
    },
    "efeitoRecorte": {
      "type": "string",
      "initial": "0"
    },
    "efeitoDuracao": {
      "type": "string",
      "initial": "3"
    },
    "efeitoVolume": {
      "type": "string",
      "initial": "15"
    },
    "efeitoFadeIn": {
      "type": "string",
      "initial": "0.1"
    },
    "efeitoFadeOut": {
      "type": "string",
      "initial": "0.2"
    }
  },
  "view": {
    "type": "Column",
    "props": {
      "padding": 24,
      "spacing": 20,
      "fillWidth": true,
      "fillHeight": true
    },
    "children": [
      {
        "type": "Column",
        "props": {
          "spacing": 8
        },
        "children": [
          {
            "type": "Text",
            "style": {
              "fontSize": 24
            },
            "props": {
              "text": "MEGALODONTE  /  VIDEO EDITOR"
            }
          },
          {
            "type": "Row",
            "props": {
              "spacing": 12
            },
            "children": [
              {
                "type": "Button",
                "props": {
                  "text": "Novo projeto",
                  "height": 36
                },
                "events": {
                  "onClick": "newProject"
                }
              },
              {
                "type": "Button",
                "props": {
                  "text": "Abrir projeto",
                  "height": 36
                },
                "events": {
                  "onClick": "openProject"
                }
              },
              {
                "type": "Button",
                "props": {
                  "text": "Salvar projeto",
                  "height": 36
                },
                "events": {
                  "onClick": "saveProject"
                }
              },
              {
                "type": "Button",
                "props": {
                  "text": "Fechar projeto",
                  "height": 36
                },
                "events": {
                  "onClick": "closeProject"
                },
                "id": "closeProjectButton"
              },
              {
                "type": "Button",
                "props": {
                  "text": "Importar imagens",
                  "height": 36
                },
                "events": {
                  "onClick": "importImages"
                }
              },
              {
                "type": "Button",
                "props": {
                  "text": "Exportar vídeo",
                  "height": 36
                },
                "events": {
                  "onClick": "exportVideo"
                },
                "id": "exportButton",
                "bind": {
                  "disabled": "exportando"
                }
              },
              {
                "type": "Button",
                "id": "settingsButton",
                "props": {
                  "text": "Configurações",
                  "height": 36
                },
                "events": {
                  "onClick": "openSettings"
                }
              },
              {
                "type": "Button",
                "id": "themeButton",
                "props": { "height": 36 },
                "bind": { "text": "themeAction" },
                "events": { "onClick": "toggleTheme" }
              }
            ]
          }
        ],
        "bind": {
          "disabled": "gerandoImagens"
        }
      },
      {
        "type": "Row",
        "props": {
          "spacing": 24,
          "fillWidth": true,
          "fillHeight": true
        },
        "children": [
          {
            "type": "Scroll",
            "id": "editorScroll",
            "props": {
              "fillWidth": true,
              "fillHeight": true
            },
            "children": [
              {
                "type": "Column",
                "props": {
                  "spacing": 12
                },
                "children": [
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 15
                    },
                    "props": {
                      "text": "PRÉVIA · YOUTUBE HORIZONTAL · 16:9"
                    }
                  },
                  {
                    "type": "ImagePreview",
                    "id": "preview",
                    "props": {
                      "height": 320
                    },
                    "bind": {
                      "source": "imagem"
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 10
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": "Efeito em todas as imagens"
                        }
                      },
                      {
                        "type": "Select",
                        "id": "visualEffectSelect",
                        "props": {
                          "width": 190,
                          "height": 36
                        },
                        "bind": {
                          "value": "motionEffect",
                          "items": "motionEffectOptions"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 14
                    },
                    "children": [
                      {
                        "type": "Button",
                        "id": "playButton",
                        "props": {
                          "height": 36
                        },
                        "bind": {
                          "text": "playLabel",
                          "disabled": "semCenas"
                        },
                        "events": {
                          "onClick": "togglePlay"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "rewindButton",
                        "props": {
                          "text": "↺ Início",
                          "height": 36
                        },
                        "bind": {
                          "disabled": "semCenas"
                        },
                        "events": {
                          "onClick": "rewind"
                        }
                      },
                      {
                        "type": "Text",
                        "bind": {
                          "text": "tempo"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 14
                    },
                    "props": {
                      "wrapWidth": 480
                    },
                    "bind": {
                      "text": "cenaTexto"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 18
                    },
                    "props": {
                      "text": "TIMELINE · IMAGENS"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 14
                    },
                    "props": {},
                    "bind": {
                      "text": "resumo"
                    }
                  },
                  {
                    "type": "ImageSequence",
                    "id": "timeline",
                    "props": {
                      "height": 160
                    },
                    "bind": {
                      "items": "timeline",
                      "selected": "selecionada"
                    },
                    "events": {
                      "onSelect": "selectScene"
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 8
                    },
                    "children": [
                      {
                        "type": "Button",
                        "props": {
                          "text": "Mover ←",
                          "height": 36
                        },
                        "events": {
                          "onClick": "moveLeft"
                        },
                        "bind": {
                          "disabled": "semSelecao"
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Mover →",
                          "height": 36
                        },
                        "events": {
                          "onClick": "moveRight"
                        },
                        "bind": {
                          "disabled": "semSelecao"
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Remover",
                          "height": 36
                        },
                        "events": {
                          "onClick": "removeScene"
                        },
                        "bind": {
                          "disabled": "semSelecao"
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Trocar imagem",
                          "height": 36
                        },
                        "events": {
                          "onClick": "replaceImage"
                        },
                        "bind": {
                          "disabled": "semSelecao"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "props": {
                      "text": "TIMELINE · EFEITOS SONOROS"
                    }
                  },
                  {
                    "type": "Button",
                    "id": "addEffectButton",
                    "props": {
                      "text": "Adicionar som…",
                      "height": 36
                    },
                    "events": {
                      "onClick": "addEffect"
                    },
                    "bind": {
                      "disabled": "semCenas"
                    }
                  },
                  {
                    "type": "SoundSequence",
                    "id": "effectsTimeline",
                    "props": {
                      "height": 170
                    },
                    "bind": {
                      "items": "efeitosTimeline",
                      "selected": "efeitoSelecionado"
                    },
                    "events": {
                      "onSelect": "selectEffect"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 480
                    },
                    "bind": {
                      "text": "efeitoNome"
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 8
                    },
                    "children": [
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 4
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Entrada (s)"
                            }
                          },
                          {
                            "type": "Input",
                            "id": "efeitoInicioInput",
                            "props": {
                              "width": 115,
                              "height": 34
                            },
                            "bind": {
                              "value": "efeitoInicio",
                              "disabled": "semEfeito"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 4
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Duração (s)"
                            }
                          },
                          {
                            "type": "Input",
                            "id": "efeitoDuracaoInput",
                            "props": {
                              "width": 115,
                              "height": 34
                            },
                            "bind": {
                              "value": "efeitoDuracao",
                              "disabled": "semEfeito"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 4
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Volume (%)"
                            }
                          },
                          {
                            "type": "Input",
                            "id": "efeitoVolumeInput",
                            "props": {
                              "width": 115,
                              "height": 34
                            },
                            "bind": {
                              "value": "efeitoVolume",
                              "disabled": "semEfeito"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 8
                    },
                    "children": [
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 4
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Recorte inicial (s)"
                            }
                          },
                          {
                            "type": "Input",
                            "id": "efeitoRecorteInput",
                            "props": {
                              "width": 115,
                              "height": 34
                            },
                            "bind": {
                              "value": "efeitoRecorte",
                              "disabled": "semEfeito"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 4
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Fade in (s)"
                            }
                          },
                          {
                            "type": "Input",
                            "id": "efeitoFadeInInput",
                            "props": {
                              "width": 115,
                              "height": 34
                            },
                            "bind": {
                              "value": "efeitoFadeIn",
                              "disabled": "semEfeito"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 4
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Fade out (s)"
                            }
                          },
                          {
                            "type": "Input",
                            "id": "efeitoFadeOutInput",
                            "props": {
                              "width": 115,
                              "height": 34
                            },
                            "bind": {
                              "value": "efeitoFadeOut",
                              "disabled": "semEfeito"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 8
                    },
                    "children": [
                      {
                        "type": "Button",
                        "id": "applyEffectButton",
                        "props": {
                          "text": "Aplicar efeito",
                          "height": 36
                        },
                        "events": {
                          "onClick": "applyEffect"
                        },
                        "bind": {
                          "disabled": "semEfeito"
                        }
                      },
                      {
                        "type": "Button",
                        "id": "removeEffectButton",
                        "props": {
                          "text": "Remover som",
                          "height": 36
                        },
                        "events": {
                          "onClick": "removeEffect"
                        },
                        "bind": {
                          "disabled": "semEfeito"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "props": {
                      "text": "Entradas em segundos do vídeo. Ao reorganizar as cenas, revise os tempos dos sons."
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 12
                    },
                    "children": [
                      {
                        "type": "Text",
                        "style": {
                          "fontSize": 14
                        },
                        "props": {
                          "text": "Duração (s)"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "durationInput",
                        "props": {
                          "width": 90,
                          "height": 36
                        },
                        "bind": {
                          "value": "duracao"
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Aplicar",
                          "height": 36
                        },
                        "events": {
                          "onClick": "applyDuration"
                        },
                        "bind": {
                          "disabled": "semSelecao"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 450,
                      "text": "ÁUDIO · NARRAÇÃO E MÚSICA"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 450
                    },
                    "bind": {
                      "text": "narracaoNome"
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 12
                    },
                    "children": [
                      {
                        "type": "Button",
                        "props": {
                          "text": "Anexar narração",
                          "height": 36
                        },
                        "events": {
                          "onClick": "attachNarration"
                        },
                        "id": "attachNarrationButton"
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Remover narração",
                          "height": 36
                        },
                        "events": {
                          "onClick": "removeNarration"
                        },
                        "bind": {
                          "disabled": "semNarracao"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Button",
                    "props": {
                      "text": "Sincronizar com whisper",
                      "height": 36
                    },
                    "events": {
                      "onClick": "syncNarration"
                    },
                    "id": "syncNarrationButton",
                    "bind": {
                      "disabled": "whisperDisabled"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 450
                    },
                    "bind": {
                      "text": "whisperStatus"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 450
                    },
                    "bind": {
                      "text": "musicaNome"
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 12
                    },
                    "children": [
                      {
                        "type": "Button",
                        "props": {
                          "text": "Adicionar música de fundo",
                          "height": 36
                        },
                        "events": {
                          "onClick": "attachMusic"
                        },
                        "id": "attachMusicButton"
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Remover música",
                          "height": 36
                        },
                        "events": {
                          "onClick": "removeMusic"
                        },
                        "bind": {
                          "disabled": "semMusica"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 12
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": "Narração (0–400%)"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "narrationVolume",
                        "props": {
                          "width": 70,
                          "height": 36
                        },
                        "bind": {
                          "value": "volumeNarracao"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Música (%)"
                        }
                      },
                      {
                        "type": "Input",
                        "id": "musicVolume",
                        "props": {
                          "width": 70,
                          "height": 36
                        },
                        "bind": {
                          "value": "volumeMusica"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Button",
                    "props": {
                      "text": "Aplicar volumes",
                      "height": 36
                    },
                    "events": {
                      "onClick": "applyVolumes"
                    },
                    "id": "applyVolumesButton"
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 450,
                      "text": "A música repete até o fim. A duração do vídeo segue a timeline."
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 450
                    },
                    "bind": {
                      "text": "exportStatus"
                    }
                  },
                  {
                    "type": "Button",
                    "props": {
                      "text": "Cancelar exportação",
                      "height": 36
                    },
                    "events": {
                      "onClick": "cancelExport"
                    },
                    "id": "cancelExportButton",
                    "bind": {
                      "visible": "exportando"
                    }
                  }
                ]
              }
            ],
            "bind": {
              "disabled": "gerandoImagens"
            }
          },
          {
            "type": "Scroll",
            "id": "scriptScroll",
            "props": {
              "width": 350,
              "fillHeight": true
            },
            "children": [
              {
                "type": "Column",
                "props": {
                  "spacing": 14,
                  "padding": 16,
                  "fillWidth": true
                },
                "children": [
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 22
                    },
                    "props": {
                      "text": "ROTEIRO"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 14
                    },
                    "props": {
                      "text": "Uma cena por parágrafo. Use uma linha em branco para separar as cenas.",
                      "wrapWidth": 300
                    }
                  },
                  {
                    "type": "TextArea",
                    "id": "scriptInput",
                    "props": {
                      "height": 350,
                      "width": 320,
                      "placeholder": "Cole seu roteiro aqui…"
                    },
                    "bind": {
                      "value": "roteiro",
                      "disabled": "gerandoImagens"
                    },
                    "validation": {
                      "required": true,
                      "label": "Roteiro",
                      "maxLength": 100000
                    }
                  },
                  {
                    "type": "Button",
                    "props": {
                      "text": "Copiar sem avatarização",
                      "height": 36
                    },
                    "events": {
                      "onClick": "copyWithoutAvatarMarkers"
                    }
                  },
                  {
                    "type": "Button",
                    "props": {
                      "text": "Criar cenas do roteiro",
                      "height": 36
                    },
                    "events": {
                      "onClick": "onSubmit"
                    },
                    "id": "createScenes",
                    "bind": {
                      "disabled": "gerandoImagens"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 16
                    },
                    "props": {
                      "text": "IMAGENS COM OPENAI"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 14
                    },
                    "props": {
                      "text": "Gera e anexa todas as cenas sem imagem, em sequência. Salve o projeto antes.",
                      "wrapWidth": 300
                    }
                  },
                  {
                    "type": "Button",
                    "id": "generateImagesButton",
                    "props": {
                      "text": "Gerar e anexar imagens",
                      "height": 36
                    },
                    "bind": {
                      "disabled": "gerandoImagens"
                    },
                    "events": {
                      "onClick": "generateImages"
                    }
                  },
                  {
                    "type": "Button",
                    "id": "cancelImagesButton",
                    "props": {
                      "text": "Cancelar geração",
                      "height": 36
                    },
                    "bind": {
                      "visible": "gerandoImagens"
                    },
                    "events": {
                      "onClick": "cancelImages"
                    }
                  },
                  {
                    "type": "Text",
                    "id": "imageGenerationStatus",
                    "props": {
                      "wrapWidth": 300
                    },
                    "bind": {
                      "text": "iaStatus"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 16
                    },
                    "props": {
                      "text": "SONS PARA O VÍDEO"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "text": "Aplica uma trilha ambiente contínua em volume baixo e efeitos pontuais compatíveis com o roteiro.",
                      "wrapWidth": 300
                    }
                  },
                  {
                    "type": "Button",
                    "id": "applySoundsButton",
                    "props": {
                      "text": "Aplicar sons",
                      "height": 36
                    },
                    "bind": {
                      "disabled": "semCenas"
                    },
                    "events": {
                      "onClick": "applySounds"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "wrapWidth": 300
                    },
                    "bind": {
                      "text": "soundStatus"
                    }
                  },
                  {
                    "type": "Text",
                    "style": {
                      "fontSize": 14
                    },
                    "props": {
                      "text": "Narração por API · não configurada"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Text",
        "style": {
          "fontSize": 14
        },
        "props": {
          "wrapWidth": 850
        },
        "bind": {
          "text": "mensagem"
        }
      }
    ]
  }
}
